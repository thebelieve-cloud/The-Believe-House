# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง (ห้าม commit .env.local ขึ้น GitHub)
#   cp .env.example .env.local

# หมายเหตุ: ตัวเว็บรันได้แม้ไม่มี .env.local (URL WordPress ฝังไว้ใน src/lib/wordpress.ts)
# ไฟล์นี้จำเป็นเฉพาะตอนโพสต์บทความด้วยสคริปต์

# ยังไม่ถูกใช้ในโค้ด — เก็บไว้ให้ตรงกับเครื่องเดิม
NEXT_PUBLIC_WORDPRESS_API_URL=

# บัญชี WordPress สำหรับ scripts/publish-post.mjs (โพสต์บทความอัตโนมัติ)
# WP_APP_PASSWORD = Application Password (สร้างใน WordPress > Users > Profile)
WP_USER=
WP_APP_PASSWORD=
